FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

convertToMeters 1;


// Vertices
vertices
(
    // =========================
    // z = 0 plane
    // =========================

    // Bottom: 4 km depth
    (0     -4000  0)   // 0
    (2000  -4000  0)   // 1

    // 3 km depth
    (0     -3000  0)   // 2
    (2000  -3000  0)   // 3

    // 2 km depth
    (0     -2000  0)   // 4
    (2000  -2000  0)   // 5

    // 500 m depth
    (0     -500   0)   // 6
    (2000  -500   0)   // 7

    // Top / seafloor
    (0      0     0)   // 8
    (2000   0     0)   // 9


    // =========================
    // z = 1 plane
    // =========================

    // Bottom: 4 km depth
    (0     -4000  1)   // 10
    (2000  -4000  1)   // 11

    // 3 km depth
    (0     -3000  1)   // 12
    (2000  -3000  1)   // 13

    // 2 km depth
    (0     -2000  1)   // 14
    (2000  -2000  1)   // 15

    // 500 m depth
    (0     -500   1)   // 16
    (2000  -500   1)   // 17

    // Top / seafloor
    (0      0     1)   // 18
    (2000   0     1)   // 19
);


blocks
(
    // ====================================
    // Layer 4: 3 - 4 km depth
    // thickness = 1000 m
    // ====================================
    hex (0 1 3 2 10 11 13 12)
    (200 100 1)
    simpleGrading (1 1 1)

    // ====================================
    // Layer 3: 2 - 3 km depth
    // thickness = 1000 m
    // ====================================
    hex (2 3 5 4 12 13 15 14)
    (200 100 1)
    simpleGrading (1 1 1)

    // ====================================
    // Layer 2: 0.5 - 2 km depth
    // thickness = 1500 m
    // ====================================
    hex (4 5 7 6 14 15 17 16)
    (200 150 1)
    simpleGrading (1 1 1)

    // ====================================
    // Layer 1: 0 - 0.5 km depth
    // thickness = 500 m
    // Pillow lava layer
    // ====================================
    hex (6 7 9 8 16 17 19 18)
    (200 50 1)
    simpleGrading (1 1 1)
);


boundary
(
    left
    {
        type patch;

        faces
        (
            (0 10 12 2)
            (2 12 14 4)
            (4 14 16 6)
            (6 16 18 8)
        );
    }


    right
    {
        type patch;

        faces
        (
            (1 3 13 11)
            (3 5 15 13)
            (5 7 17 15)
            (7 9 19 17)
        );
    }


    bottom
    {
        type patch;

        faces
        (
            (0 1 11 10)
        );
    }


    top
    {
        type patch;

        faces
        (
            (8 18 19 9)
        );
    }


    frontAndBack
    {
        type empty;

        faces
        (
            // z = 0
            (0 2 3 1)
            (2 4 5 3)
            (4 6 7 5)
            (6 8 9 7)

            // z = 1
            (10 11 13 12)
            (12 13 15 14)
            (14 15 17 16)
            (16 17 19 18)
        );
    }
);